{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Records",
    "version": "0.0.0",
    "identifier": "org.example.tidevann.records",
    "build": {
        "frontendDist": "../../web/dist",
        "beforeBuildCommand": "cd ../web && bun install && bun run build",
        "beforeDevCommand": { "script": "cd ../web && bun install && bun run build", "wait": true }
    },
    "app": {
        "windows": [
            {
                "title": "Records",
                "width": 1440,
                "height": 900,
                "minWidth": 360,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "trafficLightPosition": { "x": 12, "y": 25 }
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "icon": ["icons/icon.png"]
    }
}
