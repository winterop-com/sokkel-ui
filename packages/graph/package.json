{
    "name": "@winterop-com/sokkel-ui-graph",
    "version": "0.10.2",
    "description": "Interactive graphs on React Flow, laid out by elk, for sokkel-ui.",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/winterop-com/sokkel-ui.git",
        "directory": "packages/graph"
    },
    "files": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "dist",
        "src",
        "!src/**/*.test.*"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./styles.css": "./src/styles.css",
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepack": "cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md ."
    },
    "dependencies": {
        "@xyflow/react": "^12.12.1",
        "elkjs": "^0.12.1",
        "lucide-react": "^1.68.0"
    },
    "peerDependencies": {
        "@winterop-com/sokkel-ui": "workspace:*",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
