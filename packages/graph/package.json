{
    "name": "@winterop-com/sokkel-ui-graph",
    "version": "0.14.4",
    "description": "Interactive graphs on React Flow, laid out by elk, for sokkel-ui.",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/winterop-com/sokkel-ui.git",
        "directory": "packages/graph"
    },
    "files": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "dist",
        "src",
        "!src/**/*.test.*"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./styles.css": "./src/styles.css",
        "./sources/*.css": "./dist/sources/*.css",
        "./BlockPalette": {
            "types": "./dist/BlockPalette.d.ts",
            "import": "./dist/BlockPalette.js"
        },
        "./BlockPicker": {
            "types": "./dist/BlockPicker.d.ts",
            "import": "./dist/BlockPicker.js"
        },
        "./blocks": {
            "types": "./dist/blocks.d.ts",
            "import": "./dist/blocks.js"
        },
        "./DependencyGraph": {
            "types": "./dist/DependencyGraph.d.ts",
            "import": "./dist/DependencyGraph.js"
        },
        "./GraphCanvas": {
            "types": "./dist/GraphCanvas.d.ts",
            "import": "./dist/GraphCanvas.js"
        },
        "./GraphEdge": {
            "types": "./dist/GraphEdge.d.ts",
            "import": "./dist/GraphEdge.js"
        },
        "./GraphNode": {
            "types": "./dist/GraphNode.d.ts",
            "import": "./dist/GraphNode.js"
        },
        "./GraphOverlay": {
            "types": "./dist/GraphOverlay.d.ts",
            "import": "./dist/GraphOverlay.js"
        },
        "./GraphToolbar": {
            "types": "./dist/GraphToolbar.d.ts",
            "import": "./dist/GraphToolbar.js"
        },
        "./layout": {
            "types": "./dist/layout.d.ts",
            "import": "./dist/layout.js"
        },
        "./measure": {
            "types": "./dist/measure.d.ts",
            "import": "./dist/measure.js"
        },
        "./MiniGraph": {
            "types": "./dist/MiniGraph.d.ts",
            "import": "./dist/MiniGraph.js"
        },
        "./NetworkGraph": {
            "types": "./dist/NetworkGraph.d.ts",
            "import": "./dist/NetworkGraph.js"
        },
        "./PipelineGraph": {
            "types": "./dist/PipelineGraph.d.ts",
            "import": "./dist/PipelineGraph.js"
        },
        "./RunGraph": {
            "types": "./dist/RunGraph.d.ts",
            "import": "./dist/RunGraph.js"
        },
        "./StateMachine": {
            "types": "./dist/StateMachine.d.ts",
            "import": "./dist/StateMachine.js"
        },
        "./use-graph-history": {
            "types": "./dist/use-graph-history.d.ts",
            "import": "./dist/use-graph-history.js"
        },
        "./use-node-graph": {
            "types": "./dist/use-node-graph.d.ts",
            "import": "./dist/use-node-graph.js"
        }
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepack": "cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md ."
    },
    "dependencies": {
        "@xyflow/react": "^12.12.1",
        "elkjs": "^0.12.1",
        "lucide-react": "^1.68.0"
    },
    "peerDependencies": {
        "@winterop-com/sokkel-ui": "workspace:*",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
