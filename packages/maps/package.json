{
    "name": "@winterop-com/sokkel-ui-maps",
    "version": "0.10.17",
    "description": "Maps on maplibre, with layers, legends, popups and basemaps, for sokkel-ui.",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/winterop-com/sokkel-ui.git",
        "directory": "packages/maps"
    },
    "files": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "dist",
        "src",
        "!src/**/*.test.*"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./styles.css": "./src/styles.css",
        "./sources/*.css": "./dist/sources/*.css",
        "./basemap": {
            "types": "./dist/basemap.d.ts",
            "import": "./dist/basemap.js"
        },
        "./BasemapSwitcher": {
            "types": "./dist/BasemapSwitcher.d.ts",
            "import": "./dist/BasemapSwitcher.js"
        },
        "./BoundaryLayer": {
            "types": "./dist/BoundaryLayer.d.ts",
            "import": "./dist/BoundaryLayer.js"
        },
        "./geometry": {
            "types": "./dist/geometry.d.ts",
            "import": "./dist/geometry.js"
        },
        "./GeoJsonLayer": {
            "types": "./dist/GeoJsonLayer.d.ts",
            "import": "./dist/GeoJsonLayer.js"
        },
        "./GridLayer": {
            "types": "./dist/GridLayer.d.ts",
            "import": "./dist/GridLayer.js"
        },
        "./MapLayerList": {
            "types": "./dist/MapLayerList.d.ts",
            "import": "./dist/MapLayerList.js"
        },
        "./MapLegend": {
            "types": "./dist/MapLegend.d.ts",
            "import": "./dist/MapLegend.js"
        },
        "./MapPopup": {
            "types": "./dist/MapPopup.d.ts",
            "import": "./dist/MapPopup.js"
        },
        "./MapView": {
            "types": "./dist/MapView.d.ts",
            "import": "./dist/MapView.js"
        },
        "./PeriodSlider": {
            "types": "./dist/PeriodSlider.d.ts",
            "import": "./dist/PeriodSlider.js"
        },
        "./PointLayer": {
            "types": "./dist/PointLayer.d.ts",
            "import": "./dist/PointLayer.js"
        },
        "./scale": {
            "types": "./dist/scale.d.ts",
            "import": "./dist/scale.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        }
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepack": "cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md ."
    },
    "dependencies": {
        "@types/geojson": "^7946.0.16",
        "lucide-react": "^1.68.0",
        "maplibre-gl": "^6.7.0"
    },
    "peerDependencies": {
        "@winterop-com/sokkel-ui": "workspace:*",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "vite": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
