{
    "name": "@winterop-com/sokkel-ui",
    "version": "0.10.3",
    "description": "A shared React component library: tokens and themes, Base UI primitives and app patterns.",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/winterop-com/sokkel-ui.git",
        "directory": "packages/core"
    },
    "files": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "dist",
        "src/components",
        "src/hooks",
        "src/lib",
        "src/styles",
        "!src/**/*.test.*",
        "tokens"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./styles.css": "./src/styles/index.css",
        "./styles-base.css": "./src/styles/base.css",
        "./sources/*.css": "./dist/sources/*.css",
        "./tokens.css": "./src/styles/tokens.css",
        "./themes.css": "./src/styles/themes.css",
        "./themes/*.css": "./src/styles/themes/*.css",
        "./motion.css": "./src/styles/motion.css",
        "./typography.css": "./src/styles/typography.css",
        "./tokens.json": "./tokens/tokens.json",
        "./primitives/*": {
            "types": "./dist/components/ui/*.d.ts",
            "import": "./dist/components/ui/*.js"
        },
        "./hooks/*": {
            "types": "./dist/hooks/*.d.ts",
            "import": "./dist/hooks/*.js"
        },
        "./lib/*": {
            "types": "./dist/lib/*.d.ts",
            "import": "./dist/lib/*.js"
        },
        "./*": {
            "types": "./dist/components/*.d.ts",
            "import": "./dist/components/*.js"
        }
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepack": "cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md ."
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/ibm-plex-sans": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.68.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    },
    "peerDependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.13.1",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@lezer/highlight": "^1.2.5",
        "@shadcn/react": "^0.3.1",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "katex": "^0.16.47",
        "mermaid": "^12.3.0",
        "react": "^19.2.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.2.0",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "^4.18.0",
        "rehype-katex": "^7.0.1",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "shiki": "^4.6.0",
        "sonner": "^2.0.8"
    },
