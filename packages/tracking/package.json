{
    "name": "@winterop-com/sokkel-ui-tracking",
    "version": "0.34.7",
    "description": "Tracks for map tracking consoles, read from flight, AIS, orbit and network connection data, incidents read from earthquake, disaster and weather warning feeds, and server health checks, with the geodesy and the grid references they need, for sokkel-ui.",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/winterop-com/sokkel-ui.git",
        "directory": "packages/tracking"
    },
    "files": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "dist",
        "messages",
        "src",
        "!src/**/*.test.*"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./messages/*.json": "./messages/*.json",
        "./track": {
            "types": "./dist/track.d.ts",
            "import": "./dist/track.js"
        },
        "./adsb": {
            "types": "./dist/adsb.d.ts",
            "import": "./dist/adsb.js"
        },
        "./ais": {
            "types": "./dist/ais.d.ts",
            "import": "./dist/ais.js"
        },
        "./geo": {
            "types": "./dist/geo.d.ts",
            "import": "./dist/geo.js"
        },
        "./network": {
            "types": "./dist/network.d.ts",
            "import": "./dist/network.js"
        },
        "./affiliation": {
            "types": "./dist/affiliation.d.ts",
            "import": "./dist/affiliation.js"
        },
        "./simulate": {
            "types": "./dist/simulate.d.ts",
            "import": "./dist/simulate.js"
        },
        "./events": {
            "types": "./dist/events.d.ts",
            "import": "./dist/events.js"
        },
        "./orbits": {
            "types": "./dist/orbits.d.ts",
            "import": "./dist/orbits.js"
        },
        "./checks": {
            "types": "./dist/checks.d.ts",
            "import": "./dist/checks.js"
        },
        "./sources": {
            "types": "./dist/sources.d.ts",
            "import": "./dist/sources.js"
        }
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepack": "cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md ."
    },
    "dependencies": {
        "satellite.js": "^6.0.2"
    },
    "peerDependencies": {
        "@winterop-com/sokkel-ui": "workspace:*"
    }
}
