{
    "name": "@winterop-com/sokkel-ui-terminal",
    "version": "0.15.4",
    "description": "Terminals on xterm.js, interactive and read-only, for sokkel-ui.",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/winterop-com/sokkel-ui.git",
        "directory": "packages/terminal"
    },
    "files": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "dist",
        "src",
        "!src/**/*.test.*"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./styles.css": "./src/styles.css",
        "./sources/*.css": "./dist/sources/*.css",
        "./Terminal": {
            "types": "./dist/Terminal.d.ts",
            "import": "./dist/Terminal.js"
        },
        "./TerminalView": {
            "types": "./dist/TerminalView.d.ts",
            "import": "./dist/TerminalView.js"
        }
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepack": "cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md ."
    },
    "dependencies": {
        "@xterm/addon-fit": "0.11.0",
        "@xterm/addon-web-links": "0.12.0",
        "@xterm/xterm": "6.0.0",
        "lucide-react": "^1.68.0"
    },
    "peerDependencies": {
        "@winterop-com/sokkel-ui": "workspace:*",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
