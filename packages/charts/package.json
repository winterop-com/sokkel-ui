{
    "name": "@winterop-com/sokkel-ui-charts",
    "version": "0.27.0",
    "description": "Charts drawn from rows on ECharts, and dashboard panels, for sokkel-ui.",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/winterop-com/sokkel-ui.git",
        "directory": "packages/charts"
    },
    "files": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "dist",
        "src",
        "!src/**/*.test.*"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./styles.css": "./src/styles.css",
        "./sources/*.css": "./dist/sources/*.css",
        "./Chart": {
            "types": "./dist/Chart.d.ts",
            "import": "./dist/Chart.js"
        },
        "./chart-legend": {
            "types": "./dist/chart-legend.d.ts",
            "import": "./dist/chart-legend.js"
        },
        "./ChartFrame": {
            "types": "./dist/ChartFrame.d.ts",
            "import": "./dist/ChartFrame.js"
        },
        "./ChartGrid": {
            "types": "./dist/ChartGrid.d.ts",
            "import": "./dist/ChartGrid.js"
        },
        "./ChartLegend": {
            "types": "./dist/ChartLegend.d.ts",
            "import": "./dist/ChartLegend.js"
        },
        "./data": {
            "types": "./dist/data.d.ts",
            "import": "./dist/data.js"
        },
        "./data-columns": {
            "types": "./dist/data-columns.d.ts",
            "import": "./dist/data-columns.js"
        },
        "./kinds": {
            "types": "./dist/kinds/index.d.ts",
            "import": "./dist/kinds/index.js"
        },
        "./dashboard/BarGauge": {
            "types": "./dist/dashboard/BarGauge.d.ts",
            "import": "./dist/dashboard/BarGauge.js"
        },
        "./dashboard/BarPanel": {
            "types": "./dist/dashboard/BarPanel.d.ts",
            "import": "./dist/dashboard/BarPanel.js"
        },
        "./dashboard/ChartPanel": {
            "types": "./dist/dashboard/ChartPanel.d.ts",
            "import": "./dist/dashboard/ChartPanel.js"
        },
        "./dashboard/ComboPanel": {
            "types": "./dist/dashboard/ComboPanel.d.ts",
            "import": "./dist/dashboard/ComboPanel.js"
        },
        "./dashboard/GaugePanel": {
            "types": "./dist/dashboard/GaugePanel.d.ts",
            "import": "./dist/dashboard/GaugePanel.js"
        },
        "./dashboard/HeatmapPanel": {
            "types": "./dist/dashboard/HeatmapPanel.d.ts",
            "import": "./dist/dashboard/HeatmapPanel.js"
        },
        "./dashboard/RadarPanel": {
            "types": "./dist/dashboard/RadarPanel.d.ts",
            "import": "./dist/dashboard/RadarPanel.js"
        },
        "./dashboard/series": {
            "types": "./dist/dashboard/series.d.ts",
            "import": "./dist/dashboard/series.js"
        },
        "./dashboard/TimeSeriesPanel": {
            "types": "./dist/dashboard/TimeSeriesPanel.d.ts",
            "import": "./dist/dashboard/TimeSeriesPanel.js"
        }
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepack": "cp ../../LICENSE ../../THIRD_PARTY_NOTICES.md ."
    },
    "dependencies": {
        "echarts": "^6.1.0",
        "lucide-react": "^1.68.0"
    },
    "peerDependencies": {
        "@winterop-com/sokkel-ui": "workspace:*",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
