        },
        "./MediaBarParts": {
            "types": "./dist/MediaBarParts.d.ts",
            "import": "./dist/MediaBarParts.js"
        },
        "./MediaCard": {
            "types": "./dist/MediaCard.d.ts",
            "import": "./dist/MediaCard.js"
        },
        "./MediaFullscreen": {
            "types": "./dist/MediaFullscreen.d.ts",
            "import": "./dist/MediaFullscreen.js"
        },
        "./queue": {
            "types": "./dist/queue.d.ts",
            "import": "./dist/queue.js"
        },
        "./ReorderableTrackList": {
            "types": "./dist/ReorderableTrackList.d.ts",
