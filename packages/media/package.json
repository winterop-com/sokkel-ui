        },
        "./chapters": {
            "types": "./dist/chapters.d.ts",
            "import": "./dist/chapters.js"
        },
        "./hls-source": {
            "types": "./dist/hls-source.d.ts",
            "import": "./dist/hls-source.js"
        },
        "./lrc": {
            "types": "./dist/lrc.d.ts",
            "import": "./dist/lrc.js"
        },
        "./Lyrics": {
            "types": "./dist/Lyrics.d.ts",
            "import": "./dist/Lyrics.js"
