{
    "name": "@winterop-com/sokkel-ui-media",
    "version": "0.10.16",
    "description": "The music and video parts, the player bar, its fullscreen view, covers, track lists and the media session, for sokkel-ui.",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/winterop-com/sokkel-ui.git",
        "directory": "packages/media"
    },
    "files": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "dist",
        "src",
        "!src/**/*.test.*"
    ],
    "type": "module",
