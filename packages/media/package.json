        },
        "./UpNext": {
            "types": "./dist/UpNext.d.ts",
            "import": "./dist/UpNext.js"
        },
        "./use-frame-position": {
            "types": "./dist/use-frame-position.d.ts",
            "import": "./dist/use-frame-position.js"
        },
        "./use-media-session": {
            "types": "./dist/use-media-session.d.ts",
            "import": "./dist/use-media-session.js"
