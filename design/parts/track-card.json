{
    "$schema": "../schema/part.schema.json",
    "id": "track-card",
    "kind": "part",
    "status": "stable",
    "renderers": {
        "sokkel-ui": {
            "state": "built",
            "as_of": "67997fe"
        },
        "sokkel-egui": {
            "state": "missing",
            "as_of": "5532f68",
            "note": "Not built yet."
        },
        "sokkel-tui": {
            "state": "missing",
            "as_of": "b99664f",
            "note": "Not in sokkel-tui's reports as of b99664f."
        }
    },
    "summary": "One tracked thing, densely: its glyph, name and id, its freshness at the head's end, and under them its affiliation as a chip (a menu of the affiliations when it can be changed), the states it is in as chips, and a quiet line of what it is doing. A thumbnail may lead it. Framed it is a card; unframed, a list's row.",
    "sources": {
        "sokkel-ui": [
            "packages/core/src/components/TrackCard.tsx",
            "packages/core/src/components/TrackGlyph.tsx",
            "packages/core/src/components/Freshness.tsx",
            "packages/core/src/components/Chip.tsx"
        ]
    },
    "anatomy": {
        "container": "A row 10 apart: the thumbnail, then a column of two lines 4 apart. Framed: on card with a border edge, rounded by radius-surface, padded 10, in card-foreground.",
        "thumbnail": "With thumbnail: 40 square, rounded by radius-control, on muted, its picture covering it.",
        "head": "The glyph (parts/track-glyph, md, named), the name at 500 cut with an ellipsis, the id in the code face at text.help in muted-foreground giving way first, 8 apart; the freshness (parts/freshness) at the line's end.",
        "chips": "The affiliation as a chip with a dot in its color (parts/chip), a menu of the five affiliations with onAffiliationChange; each state an outline chip, or in its tone; then the detail at text.help in muted-foreground, 6 apart, wrapping.",
        "name": "The track's name, cut with an ellipsis.",
        "code": "The track's id after its name, in the code face.",
        "detail": "A line under the chips: speed and heading, or what the app says."
    },
    "standsOn": {
        "default": "background"
    },
    "options": {
        "name": {
            "type": "text",
            "does": "What it is called."
        },
        "code": {
            "type": "text",
            "does": "Its id, after the name."
        },
        "kind": {
            "values": ["vessel", "aircraft", "vehicle", "sensor", "satellite", "other"],
            "does": "Its glyph."
        },
        "affiliation": {
            "values": ["friend", "hostile", "neutral", "unknown", "pending"],
            "does": "Its color and its chip."
        },
        "heading": {
            "type": "number",
            "does": "Turns the glyph."
        },
        "thumbnail": {
            "type": "node",
            "does": "A picture at the start."
        },
        "states": {
            "type": "rows",
            "does": "Chips for its states: a word, or a word in a tone."
        },
        "detail": {
            "type": "node",
            "does": "One quiet line, such as speed and heading."
        },
        "updatedAt": {
            "type": "text",
            "does": "When it was last heard from; the freshness is drawn only with it."
        },
        "onAffiliationChange": {
            "type": "callback",
            "does": "Makes the affiliation chip a menu of the affiliations."
        },
        "onSelect": {
            "type": "callback",
            "does": "Makes the whole card one control."
        },
        "selected": {
            "type": "boolean",
            "default": false,
            "does": "Draws it as chosen."
        },
        "framed": {
            "type": "boolean",
            "default": true,
            "does": "false drops the edge, ground and padding for a list's row."
        }
    },
    "sizes": {
        "container": {
            "padX": 10,
            "padY": 10,
            "gap": 10,
            "radius": "radius-surface"
        },
        "thumbnail": {
            "width": 40,
            "height": 40,
            "radius": "radius-control"
        },
        "head": {
            "gap": 8,
            "text": "text.body"
        }
    },
    "states": {
        "rest": {
            "means": "The card drawn."
        },
        "hover": {
            "means": "The pointer over a card that is a control: washed.",
            "reached": "pointer over, with onSelect"
        },
        "selected": {
            "means": "The card chosen: edged and ringed in primary.",
            "reached": "selected"
        },
        "focus": {
            "means": "Keyboard focus on the card: the focus outline around it.",
            "reached": "Tab, with onSelect",
            "on": "keyboard"
        }
    },
    "pieces": {
        "container": {
            "rest": {
                "ground": "card",
                "edge": "border",
                "ink": "card-foreground",
                "radius": "radius-surface",
                "note": "framed"
            },
            "hover": {
                "ground": "hover"
            },
            "selected": {
                "edge": "primary",
                "ring": {
                    "color": "primary",
                    "width": 1
                }
            },
            "focus": {
                "ring": {
                    "color": "ring",
                    "width": "focus-ring-width",
                    "offset": "focus-ring-offset"
                }
            }
        },
        "name": {
            "rest": {
                "weight": 500,
                "text": "text.sm"
            }
        },
        "code": {
            "rest": {
                "ink": "muted-foreground",
                "text": "text.help",
                "note": "In the code face."
            }
        },
        "detail": {
            "rest": {
                "ink": "muted-foreground",
                "text": "text.help"
            }
        }
    },
    "keyboard": [
        {
            "keys": ["Tab"],
            "does": "Reaches the card when it is a control, then the affiliation chip's menu."
        },
        {
            "keys": ["Enter"],
            "does": "Calls onSelect.",
            "when": "the card has focus"
        }
    ],
    "words": {
        "changeAffiliation": "Affiliation: {affiliation}. Change"
    },
    "messages": {
        "changeAffiliation": {
            "id": "trackCard.changeAffiliation",
            "en": "Affiliation: {affiliation}. Change"
        }
    },
    "appText": {
        "name": "The track's name.",
        "code": "Its id.",
        "detail": "What it is doing.",
        "states": "Its states."
    },
    "rendererSpecific": {
        "sokkel-ui": ["With onSelect a button covers the card under its pieces; the affiliation chip stands over it as its own control."]
    },
    "drift": [
        {
            "renderer": "sokkel-egui",
            "what": "not built yet",
            "spec": "This spec.",
            "today": "As of 5532f68: no such part."
        },
        {
            "renderer": "sokkel-tui",
            "what": "not built yet",
            "spec": "This spec.",
            "today": "As of b99664f its reports name no such part."
        }
    ],
    "samples": {
        "changeAffiliation": [
            {
                "with": {
                    "affiliation": "Hostile"
                },
                "says": "Affiliation: Hostile. Change"
            }
        ]
    }
}
