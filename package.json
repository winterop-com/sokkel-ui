{
    "name": "@winterop-com/ui",
    "version": "0.2.0",
    "description": "A shared React component library: tokens and themes, Base UI primitives, app patterns, and their stories.",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/winterop-com/winterop-ui.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "dist",
        "src",
        "tokens"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./styles.css": "./src/styles/index.css",
        "./tokens.css": "./src/styles/tokens.css",
        "./tokens.json": "./tokens/tokens.json",
        "./primitives/*": {
            "types": "./dist/components/ui/*.d.ts",
            "import": "./dist/components/ui/*.js"
        },
        "./hooks/*": {
            "types": "./dist/hooks/*.d.ts",
            "import": "./dist/hooks/*.js"
        },
        "./lib/*": {
            "types": "./dist/lib/*.d.ts",
            "import": "./dist/lib/*.js"
        },
        "./*": {
            "types": "./dist/components/*.d.ts",
            "import": "./dist/components/*.js"
        }
    },
    "scripts": {
        "tokens": "bun scripts/build-tokens.ts",
        "storybook": "storybook dev -p 6106 --no-open",
        "build-storybook": "storybook build -o storybook-static",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:visual": "bun run build-storybook && playwright test",
        "test:visual:update": "bun run build-storybook && playwright test --update-snapshots",
        "test:visual:tiles": "node e2e/record-tiles.ts",
        "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
        "lint": "oxlint --deny-warnings",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test:visual:linux": "scripts/visual-linux.sh",
        "test:visual:linux:update": "scripts/visual-linux.sh --update-snapshots"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.13.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@fontsource-variable/ibm-plex-sans": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@lezer/highlight": "^1.2.5",
        "@shadcn/react": "^0.3.1",
        "@types/geojson": "^7946.0.16",
        "@xyflow/react": "^12.12.1",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "echarts": "^6.1.0",
        "elkjs": "^0.12.1",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.68.0",
        "maplibre-gl": "^6.7.0",
        "mermaid": "^12.3.0",
        "next-themes": "^0.4.6",
        "react-day-picker": "^10.0.2",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "^4.18.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "shiki": "^4.6.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@storybook/addon-a11y": "^10",
        "@storybook/addon-docs": "^10",
        "@storybook/react-vite": "^10",
        "@tailwindcss/vite": "^4.3.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "http-server": "^14.1.1",
        "oxfmt": "^0.76.0",
        "oxlint": "^1.91.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "storybook": "^10",
        "tailwindcss": "^4.3.4",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
