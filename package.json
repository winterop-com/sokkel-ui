{
    "name": "sokkel-ui-workspace",
    "private": true,
    "description": "The sokkel-ui packages, their Storybook and the tools that check them.",
    "license": "SEE LICENSE IN LICENSE",
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "tokens": "bun scripts/build-tokens.ts",
        "components": "bun scripts/components-index.ts",
        "storybook": "storybook dev -p 6106 --no-open",
        "build-storybook": "storybook build -o storybook-static",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:visual": "scripts/baselines.sh checkout && bun run build-storybook && playwright test",
        "test:visual:update": "scripts/baselines.sh checkout && bun run build-storybook && playwright test --update-snapshots",
        "test:visual:tiles": "node e2e/record-tiles.ts",
        "build": "bun run --cwd packages/core build && bun run --cwd packages/charts build && bun run --cwd packages/maps build && bun run --cwd packages/graph build && bun run --cwd packages/terminal build && bun run --cwd packages/media build",
        "size": "tsc -p size && bun scripts/size-budget.ts",
        "lint": "oxlint --deny-warnings",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test:visual:linux": "scripts/visual-linux.sh",
        "test:visual:linux:update": "scripts/visual-linux.sh --update-snapshots"
    },
    "devDependencies": {
        "@codemirror/autocomplete": "6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.13.1",
        "@codemirror/legacy-modes": "^6.5.5",
        "@codemirror/lint": "6.9.7",
        "@codemirror/search": "6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@lezer/highlight": "^1.2.5",
        "@playwright/test": "^1.64.1",
        "@shadcn/react": "^0.3.1",
        "@storybook/addon-a11y": "^10",
        "@storybook/addon-docs": "^10",
        "@storybook/react-vite": "^10",
        "@tailwindcss/vite": "^4.3.4",
        "@types/geojson": "^7946.0.16",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@winterop-com/sokkel-ui": "workspace:*",
        "@winterop-com/sokkel-ui-charts": "workspace:*",
        "@winterop-com/sokkel-ui-graph": "workspace:*",
        "@winterop-com/sokkel-ui-maps": "workspace:*",
        "@winterop-com/sokkel-ui-media": "workspace:*",
        "@winterop-com/sokkel-ui-terminal": "workspace:*",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "hls.js": "1.7.3",
        "http-server": "^14.1.1",
        "input-otp": "^1.5.0",
        "katex": "^0.16.47",
        "lucide-react": "^1.68.0",
        "mermaid": "^12.3.0",
        "oxfmt": "^0.76.0",
        "oxlint": "^1.91.0",
        "react": "^19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "^4.18.0",
        "rehype-katex": "^7.0.1",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "shiki": "^4.6.0",
        "sonner": "^2.0.8",
        "storybook": "^10",
        "tailwindcss": "^4.3.4",
        "typescript": "^7.0.2",
        "unified": "^11.0.5",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    }
}
